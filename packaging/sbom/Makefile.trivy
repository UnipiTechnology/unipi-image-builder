
# Trivy-based SBOM generation. Runs 'trivy rootfs' against the extracted
# image (SBOM_ROOTFS, provided by Makefile.common) and contributes per-format
# outputs to SBOM_FILES + IMAGES.
#
# --pkg-types os,library makes sure the SBOM carries both the OS (dpkg)
# packages and the language-library packages with PURLs that match the
# vulnerability databases used by DependencyTrack and similar tools.
# It is Trivy's current default, but we pass it explicitly so the output
# stays stable regardless of the host Trivy version.

SBOM_TRIVY  ?= trivy
SBOM_TRIVY_OPTS ?= --quiet --offline-scan --pkg-types os,library

ifeq ($(CONFIG_SBOM_CYCLONEDX),y)
IMAGES     += $(BASEIMAGE).cdx.json
SBOM_FILES += $(BASEIMAGE).cdx.json
$(BASEIMAGE).cdx.json: $(SBOM_STAMP)
	$(SBOM_TRIVY) rootfs $(SBOM_TRIVY_OPTS) --format cyclonedx --output $@ $(SBOM_ROOTFS)
# Enrich the CycloneDX with unipi-kernel fork lineage (pedigree + cpe)
# from the upstream-metadata.json the kernel .deb installs. No-op if the
# metadata file is absent (older deb / non-kernel image), so this never
# breaks the build. Requires python3 on the SBOM host.
	@if command -v python3 >/dev/null 2>&1; then \
		python3 packaging/sbom/enrich-cdx.py $@ $(SBOM_ROOTFS); \
	else \
		echo "SBOM: python3 not found, skipping unipi-kernel lineage enrichment" >&2; \
	fi
# Per-file SHA-256 hashes (TR-03183-2 §5.2.2). Adds unipi:fileHash:sha256
# properties per installed file. Significantly increases SBOM size.
ifeq ($(CONFIG_SBOM_HASHES),y)
	@if command -v python3 >/dev/null 2>&1; then \
		python3 packaging/sbom/enrich-hashes.py $@ $(SBOM_ROOTFS); \
	else \
		echo "SBOM: python3 not found, skipping hash enrichment" >&2; \
	fi
endif
endif

ifeq ($(CONFIG_SBOM_VEX),y)
# CIP kernel VEX. Requires the YAML output of cip-kernel-sec's
# report_affected.py for the target CIP branch (with the exact built tag),
# e.g.:
#   report_affected.py --output-format yaml -o affected.yaml \
#       --branch cip/6.12:v6.12.94-cip26
# Override via the environment or .config:
#   SBOM_VEX_REPORT - path to that YAML file
SBOM_VEX_REPORT ?= $(CONFIG_SBOM_VEX_REPORT)

ifneq ($(SBOM_VEX_REPORT),)
IMAGES     += $(BASEIMAGE).vex.json
SBOM_FILES += $(BASEIMAGE).vex.json
$(BASEIMAGE).vex.json: $(BASEIMAGE).cdx.json $(SBOM_STAMP)
	@if command -v python3 >/dev/null 2>&1; then \
		python3 packaging/sbom/gen-vex.py $< $(SBOM_ROOTFS) \
			$(SBOM_VEX_REPORT) > $@; \
	else \
		echo "SBOM: python3 not found, skipping VEX generation" >&2; \
	fi
else
$(error SBOM_VEX enabled but SBOM_VEX_REPORT not set (path to report_affected.py --output-format yaml output))
endif
endif

ifeq ($(CONFIG_SBOM_SPDX),y)
IMAGES     += $(BASEIMAGE).spdx
SBOM_FILES += $(BASEIMAGE).spdx
$(BASEIMAGE).spdx: $(SBOM_STAMP)
	$(SBOM_TRIVY) rootfs $(SBOM_TRIVY_OPTS) --format spdx --output $@ $(SBOM_ROOTFS)
endif

ifeq ($(CONFIG_SBOM_SPDX_JSON),y)
IMAGES     += $(BASEIMAGE).spdx.json
SBOM_FILES += $(BASEIMAGE).spdx.json
$(BASEIMAGE).spdx.json: $(SBOM_STAMP)
	$(SBOM_TRIVY) rootfs $(SBOM_TRIVY_OPTS) --format spdx-json --output $@ $(SBOM_ROOTFS)
# Per-file SHA-256 hashes (TR-03183-2 §5.2.2). Adds files[] with SHA-256
# checksums + CONTAINS relationships + filesAnalyzed/packageVerificationCode.
# Significantly increases SBOM size.
ifeq ($(CONFIG_SBOM_HASHES),y)
	@if command -v python3 >/dev/null 2>&1; then \
		python3 packaging/sbom/enrich-hashes.py $@ $(SBOM_ROOTFS); \
	else \
		echo "SBOM: python3 not found, skipping hash enrichment" >&2; \
	fi
endif
endif

ifeq ($(CONFIG_SBOM_GITHUB),y)
IMAGES     += $(BASEIMAGE).github.json
SBOM_FILES += $(BASEIMAGE).github.json
$(BASEIMAGE).github.json: $(SBOM_STAMP)
	$(SBOM_TRIVY) rootfs $(SBOM_TRIVY_OPTS) --format github --output $@ $(SBOM_ROOTFS)
endif

ifeq ($(CONFIG_SBOM_TABLE),y)
IMAGES     += $(BASEIMAGE).trivy.txt
SBOM_FILES += $(BASEIMAGE).trivy.txt
$(BASEIMAGE).trivy.txt: $(SBOM_STAMP)
	$(SBOM_TRIVY) rootfs $(SBOM_TRIVY_OPTS) --format table --output $@ $(SBOM_ROOTFS)
endif
